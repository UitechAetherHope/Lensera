# 复制为 .env 后按阿里云公网 IP 修改（仓库根目录执行：cp .env.example .env）

# 浏览器访问地址（无域名、无 HTTPS 时填 http://公网IP，不要末尾斜杠）
APP_PUBLIC_BASE_URL=http://123.45.67.89

# 与本地一致的 MySQL / Redis（仅容器内网访问，可不暴露到公网）
MYSQL_ROOT_PASSWORD=Mcl12345
REDIS_PASSWORD=Mcl12345

# JWT（与 application.properties 默认一致；生产可换更长随机串）
JWT_SECRET=PhotoBlogJwtSecretKeyMustBeAtLeast32CharactersLongForHS256

# 豆包方舟（作品 AI 自动分类）
DOUBAO_API_KEY=ark-your-key-here

# QQ 邮箱 SMTP 授权码（非 QQ 登录密码）
SPRING_MAIL_USERNAME=your@qq.com
SPRING_MAIL_PASSWORD=your-smtp-auth-code

# 宿主机 Photo_base 目录（git clone 后把 Win 的 Photo_base 拷到此路径）
PHOTO_BASE_HOST_PATH=./data/Photo_base
